# ─── Quidesk — Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local for local development overrides.
# In production, data flows exclusively through the Cloudflare Worker feed.
# No upstream vendor API keys should ever be exposed in the client bundle.

# Cloudflare Worker Feed Endpoint (Defaults to /api or worker URL)
VITE_FEED_URL=https://quidesk-market-engine.<your-subdomain>.workers.dev

# Cloudflare Deployment Credentials (CI/CD only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
