# ─── Quidesk — Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.

# Gold-API — Gold, Silver, Platinum, Copper (FREE)
# Get your free key at https://gold-api.com
VITE_GOLD_API_KEY=

# Alpha Vantage — Stocks (FREE — 25 requests/day)
# Get your free key at https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_KEY=

# Twelve Data — Stocks + Crypto (FREE — 800 requests/day)
# Get your free key at https://twelvedata.com/pricing
VITE_TWELVE_DATA_KEY=

# CoinGecko Pro — Higher rate limits for crypto (free tier available)
# Basic crypto works without any key via the free public API
VITE_COINGECKO_PRO_KEY=

# Binance WebSocket — Real-time crypto ticks (FREE, no key needed)
# Connects automatically — no configuration required
