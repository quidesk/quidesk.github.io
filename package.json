{
  "name": "quidesk",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Quidesk — The trader's desk. All-in-one market intelligence terminal with live heatmaps, correlation maps, hotspot detection and cross-asset comparison.",
  "scripts": {
    "dev": "vite",
    "og": "node scripts/generate-og.mjs",
    "verifyq": "node scripts/verifyq.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "cf:whoami": "wrangler whoami",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.12.7",
    "swr": "^2.5.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jimp": "^1.6.1",
    "puppeteer-core": "^25.16.0",
    "esbuild": "0.28.2",
    "vite": "^5.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.159.0",
    "yahoo-finance2": "^4.0.2"
  }
}
